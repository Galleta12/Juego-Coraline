# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env y rellena lo que quieras usar.
#  En producción, ponlos como variables de entorno en Vercel:
#  Settings → Environment Variables. NUNCA subas el .env al repo.
#
#  Si dejas todo vacío, el juego funciona igual: los avisos se
#  quedan en los logs del despliegue en vez de llegar por correo.
# ─────────────────────────────────────────────────────────────

# Dónde te llegan los avisos.
OWNER_EMAIL=

# Proveedor de correo. Por ahora solo "resend", o vacío para no enviar.
MAIL_PROVIDER=

# API key de Resend (https://resend.com → API Keys).
# Plan gratuito: 100 correos/día, de sobra.
RESEND_API_KEY=

# Remitente. Con el dominio de pruebas de Resend puedes usar
# onboarding@resend.dev sin verificar nada tuyo.
EXPEDITION_FROM_EMAIL=onboarding@resend.dev

# Privacidad: por defecto NO se registra la IP de quien abre el juego.
# Si lo pones en true, se guarda truncada (1.2.x.x), nunca completa.
CAPTURE_IP=false
